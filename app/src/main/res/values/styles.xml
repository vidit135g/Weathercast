<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================
         Soma design system — one warm, editorial light theme.
         Fraunces for display, Poppins for everything else.
         ============================================================ -->

    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/soma_ember</item>
        <item name="colorPrimaryDark">@color/soma_bg</item>
        <item name="colorAccent">@color/soma_ember</item>
        <item name="android:colorBackground">@color/soma_bg</item>
        <item name="android:windowBackground">@color/soma_bg</item>
        <item name="android:textColor">@color/soma_ink</item>
        <item name="android:textColorPrimary">@color/soma_ink</item>
        <item name="android:textColorSecondary">@color/soma_text_muted</item>
        <item name="android:textColorHint">@color/soma_text_muted</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="colorControlActivated">@color/soma_ember</item>
        <item name="colorControlHighlight">#22000000</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/soma_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowAnimationStyle">@style/Soma.WindowAnimation</item>
        <!-- legacy aliases still read by old layouts -->
        <item name="colorBackground">@color/soma_bg</item>
        <item name="colorTintedBackground">@color/soma_surface_muted</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme" />
    <style name="AppTheme.NoActionBar.Dark" parent="AppTheme" />
    <style name="AppTheme.NoActionBar.Black" parent="AppTheme" />
    <style name="AppTheme.NoActionBar.Classic" parent="AppTheme" />
    <style name="AppTheme.NoActionBar.Classic.Dark" parent="AppTheme" />
    <style name="AppTheme.NoActionBar.Classic.Black" parent="AppTheme" />
    <style name="AppTheme.NoStatusBar" parent="AppTheme" />

    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/soma_bg</item>
        <item name="android:navigationBarColor">@color/soma_bg</item>
    </style>

    <style name="MyApp.ActionBarTheme" parent="ThemeOverlay.AppCompat.ActionBar">
        <item name="colorControlNormal">@color/soma_ink</item>
        <item name="android:background">@color/soma_bg</item>
        <item name="android:textColor">@color/soma_ink</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.ActionBar" />
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
    <style name="AppTheme.PopupOverlay.Dark" parent="ThemeOverlay.AppCompat.Light" />
    <style name="AppTheme.PopupOverlay.Black" parent="ThemeOverlay.AppCompat.Light" />

    <!-- ============================================================
         Type ramp
         ============================================================ -->
    <style name="Soma.Display" parent="">
        <item name="android:fontFamily">@font/fraunces</item>
        <item name="android:textColor">@color/soma_ink</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Soma.Title" parent="Soma.Display">
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Soma.Heading" parent="Soma.Display">
        <item name="android:textSize">19sp</item>
    </style>

    <style name="Soma.Body" parent="">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/soma_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">3sp</item>
    </style>

    <style name="Soma.Label" parent="">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/soma_text_muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Soma.WindowAnimation" parent="">
        <item name="android:activityOpenEnterAnimation">@anim/soma_activity_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/soma_activity_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/soma_activity_pop_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/soma_activity_pop_exit</item>
    </style>

    <style name="Soma.GridRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:baselineAligned">false</item>
        <item name="android:weightSum">2</item>
    </style>

    <style name="Soma.Tile" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">150dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bento_tile</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="Soma.TileSmall" parent="Soma.Tile">
        <item name="android:layout_height">116dp</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="Soma.TileIcon" parent="">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:background">@drawable/soma_icon_chip</item>
    </style>

    <style name="Soma.TileIconSmall" parent="">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:padding">7dp</item>
        <item name="android:background">@drawable/soma_icon_chip</item>
    </style>

    <style name="Soma.TileValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/soma_ink</item>
        <item name="android:textSize">19sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Soma.MenuRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:drawablePadding">20dp</item>
        <item name="android:drawableTint">@color/soma_text_secondary</item>
        <item name="android:background">?android:selectableItemBackground</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/soma_ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="TabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/soma_text_muted</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- ============================================================
         Components
         ============================================================ -->
    <style name="AppTheme.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/soma_button</item>
        <item name="android:textColor">@color/soma_on_fill</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingLeft">28dp</item>
        <item name="android:paddingRight">28dp</item>
    </style>

    <style name="BottomSheet" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bento_sheet_bg</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <style name="BaseBottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="bottomSheetStyle">@style/BottomSheet</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="BaseBottomSheetDialog">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/soma_bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="CustomDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">@color/soma_ember</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="dialogCornerRadius" tools:targetApi="p">24dp</item>
        <item name="android:textColorPrimary">@color/soma_ink</item>
        <item name="android:windowBackground">@drawable/background_dialog</item>
    </style>

    <style name="CustomFragmentDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">@color/soma_ember</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="dialogCornerRadius" tools:targetApi="p">24dp</item>
        <item name="android:textColorPrimary">@color/soma_ink</item>
        <item name="android:windowBackground">@drawable/background_dialog</item>
    </style>

</resources>
