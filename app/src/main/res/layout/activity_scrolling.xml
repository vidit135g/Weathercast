<!--suppress ALL -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:id="@+id/viewApp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/soma_bg"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
        android:id="@+id/toolbar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:theme="@style/ThemeOverlay.AppCompat.Light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center">

                <TextView
                    android:id="@+id/citytool"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:textColor="@color/soma_ink"
                    android:text="LUCKNOW"
                    android:letterSpacing="0.14"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <com.miguelcatalan.materialsearchview.MaterialSearchView
            android:id="@+id/search_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <RelativeLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/actionBarSize"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="16dp"
                android:background="@drawable/bento_tile_hero"
                android:paddingHorizontal="24dp"
                android:paddingTop="22dp"
                android:paddingBottom="22dp">

                <TextView
                    android:id="@+id/todayDate"
                    style="@style/Soma.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Friday 06 September" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/todayTemperature"
                            style="@style/Soma.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="66sp"
                            tools:text="27°" />

                        <TextView
                            android:id="@+id/todayDescription"
                            style="@style/Soma.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="18sp"
                            tools:text="Haze" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/todayIcon"
                        android:layout_width="118dp"
                        android:layout_height="118dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/sleet" />
                </RelativeLayout>

                <!-- Soma metric pills -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <LinearLayout style="@style/Soma.Body" android:id="@+id/pillFeels"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical" android:background="@drawable/soma_pill"
                        android:paddingHorizontal="14dp" android:paddingVertical="8dp" android:layout_marginEnd="8dp">
                        <TextView style="@style/Soma.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Feels" android:textSize="9sp" />
                        <TextView android:id="@+id/todayFeelsLike" android:fontFamily="@font/poppins" android:textStyle="bold" android:textColor="@color/soma_ink" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="29°" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical" android:background="@drawable/soma_pill"
                        android:paddingHorizontal="14dp" android:paddingVertical="8dp" android:layout_marginEnd="8dp">
                        <TextView style="@style/Soma.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wind" android:textSize="9sp" />
                        <TextView android:id="@+id/todayWindPill" android:fontFamily="@font/poppins" android:textStyle="bold" android:textColor="@color/soma_ink" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="3 m/s" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical" android:background="@drawable/soma_pill"
                        android:paddingHorizontal="14dp" android:paddingVertical="8dp">
                        <TextView style="@style/Soma.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UV" android:textSize="9sp" />
                        <TextView android:id="@+id/todayUvPill" android:fontFamily="@font/poppins" android:textStyle="bold" android:textColor="@color/soma_ink" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="5" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/todayDes"
                    style="@style/Soma.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    tools:text="Haze, pollution causing low visibility over several parts." />
            </LinearLayout>
        </RelativeLayout>
    </FrameLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/bottomsheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:layout_marginTop="5dp">

        <include layout="@layout/content_main" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
