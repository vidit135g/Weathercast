<!--suppress ALL -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:id="@+id/viewApp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/soma_bg"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
        android:id="@+id/toolbar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:contentInsetStart="16dp"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:theme="@style/ThemeOverlay.AppCompat.Light" />

        <com.miguelcatalan.materialsearchview.MaterialSearchView
            android:id="@+id/search_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="?attr/actionBarSize"
            android:paddingHorizontal="20dp"
            android:paddingBottom="12dp"
            android:layoutAnimation="@anim/soma_stagger">

            <TextView
                android:id="@+id/todayDate"
                style="@style/Soma.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Saturday 6 September" />

            <TextView
                android:id="@+id/citytool"
                style="@style/Soma.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Lucknow" />

            <LinearLayout
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="18dp"
                android:background="@drawable/soma_hero_fallback"
                android:paddingHorizontal="22dp"
                android:paddingTop="22dp"
                android:paddingBottom="22dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/todayTemperature"
                            style="@style/Soma.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/soma_on_fill"
                            android:textSize="70sp"
                            tools:text="27°" />

                        <TextView
                            android:id="@+id/todayDescription"
                            style="@style/Soma.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/soma_on_fill"
                            android:textSize="18sp"
                            tools:text="Haze" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/todayIcon"
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/soma_wx_cloudy" />
                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/pillRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:weightSum="3"
                    android:layout_marginTop="18dp">

                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:gravity="center" android:background="@drawable/soma_pill_hero"
                        android:paddingVertical="10dp" android:layout_marginEnd="8dp">
                        <TextView style="@style/Soma.Label" android:id="@+id/pillLabelFeels" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Feels" android:textSize="9sp" android:textColor="@color/soma_on_fill" />
                        <TextView android:id="@+id/todayFeelsLike" android:fontFamily="@font/fraunces" android:textColor="@color/soma_on_fill" android:textSize="16sp" android:layout_marginTop="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="29°" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:gravity="center" android:background="@drawable/soma_pill_hero"
                        android:paddingVertical="10dp" android:layout_marginEnd="8dp">
                        <TextView style="@style/Soma.Label" android:id="@+id/pillLabelWind" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wind" android:textSize="9sp" android:textColor="@color/soma_on_fill" />
                        <TextView android:id="@+id/todayWindPill" android:fontFamily="@font/fraunces" android:textColor="@color/soma_on_fill" android:textSize="16sp" android:layout_marginTop="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="3" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:gravity="center" android:background="@drawable/soma_pill_hero"
                        android:paddingVertical="10dp">
                        <TextView style="@style/Soma.Label" android:id="@+id/pillLabelUv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UV" android:textSize="9sp" android:textColor="@color/soma_on_fill" />
                        <TextView android:id="@+id/todayUvPill" android:fontFamily="@font/fraunces" android:textColor="@color/soma_on_fill" android:textSize="16sp" android:layout_marginTop="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="5" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/todayDes"
                    style="@style/Soma.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textColor="@color/soma_on_fill"
                    tools:text="Haze, pollution causing low visibility over several parts." />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/bottomsheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:layout_marginTop="5dp">

        <include layout="@layout/content_main" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
