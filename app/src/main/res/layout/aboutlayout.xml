<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    android:background="@drawable/bento_dialog"
    android:clipToOutline="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/soma_wx_clear_day" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/fraunces"
        android:letterSpacing="-0.02"
        android:text="Weathercast"
        android:textColor="@color/soma_ink"
        android:textSize="27sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/poppins"
        android:letterSpacing="0.04"
        android:text="THE ABSOLUTE CORPORATION"
        android:textColor="@color/soma_text_muted"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/poppins"
        android:gravity="center"
        android:lineSpacingMultiplier="1.35"
        android:text="The sky keeps no secrets from those who look up. We just made looking up a little more beautiful."
        android:textColor="@color/soma_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/aboutVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/poppins"
        android:text="Version"
        android:textColor="@color/soma_text_muted"
        android:textSize="11sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/poppins"
        android:text="Made in India 🇮🇳"
        android:textColor="@color/soma_text_muted"
        android:textSize="11sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/pixelbutton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/soma_button"
        android:fontFamily="@font/poppins"
        android:text="Great"
        android:textAllCaps="false"
        android:textColor="@color/soma_on_fill"
        android:textSize="15sp" />
</LinearLayout>
