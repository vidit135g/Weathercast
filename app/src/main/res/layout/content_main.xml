<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/peeklayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bento_sheet_bg"
    android:elevation="10dp"
    android:animateLayoutChanges="true"
    app:behavior_hideable="false"
    app:behavior_peekHeight="175dp"
    app:layout_behavior="@string/view_pager_bottom_sheet_behavior"
    tools:context=".activities.MainActivity"
    tools:showIn="@layout/activity_scrolling">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll"
            app:titleEnabled="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="10dp"
                android:layoutAnimation="@anim/soma_stagger">

                <View
                    android:layout_width="40dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/bento_grabber" />

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <!-- At-a-glance conditions summary -->
                <LinearLayout
                    android:id="@+id/glanceCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/soma_reading_card"
                    android:padding="20dp">

                    <TextView
                        style="@style/Soma.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="At a glance" />

                    <TextView
                        android:id="@+id/todayReadingHeadline"
                        style="@style/Soma.Display"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="18sp"
                        android:lineSpacingExtra="2sp"
                        tools:text="Haze and mild, with a steady breeze." />

                    <TextView
                        android:id="@+id/todayReadingAdvice"
                        style="@style/Soma.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        tools:text="Comfortable conditions — a good window to be outside. 12h 40m of daylight today." />
                </LinearLayout>

                <TextView style="@style/Soma.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="More info" android:layout_marginTop="26dp" android:layout_marginBottom="12dp" />

                <!-- 2x2 metric grid — every tile the same size -->
                <LinearLayout style="@style/Soma.GridRow">
                    <LinearLayout style="@style/Soma.Tile" android:layout_marginEnd="6dp">
                        <TextView style="@style/Soma.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wind &amp; compass" />
                        <ImageView android:id="@+id/wind" style="@style/Soma.TileIcon" android:background="@drawable/soma_chip_forest" android:src="@drawable/ic_feather_wind" android:tint="@color/soma_forest" />
                        <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                        <TextView android:id="@+id/todayWind" style="@style/Soma.TileValue" tools:text="3.4 m/s NE" />
                    </LinearLayout>
                    <LinearLayout style="@style/Soma.Tile" android:layout_marginStart="6dp">
                        <TextView style="@style/Soma.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Humidity &amp; dew point" />
                        <ImageView android:id="@+id/humid" style="@style/Soma.TileIcon" android:background="@drawable/soma_chip_indigo" android:src="@drawable/ic_feather_droplet" android:tint="@color/soma_indigo" />
                        <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                        <TextView android:id="@+id/todayHumidity" style="@style/Soma.TileValue" tools:text="64 %" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/Soma.GridRow" android:layout_marginTop="12dp">
                    <LinearLayout style="@style/Soma.Tile" android:layout_marginEnd="6dp">
                        <TextView style="@style/Soma.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UV index" />
                        <ImageView style="@style/Soma.TileIcon" android:background="@drawable/soma_chip_ember" android:src="@drawable/ic_feather_sun" android:tint="@color/soma_ember" />
                        <TextView android:id="@+id/todayUvIndex" style="@style/Soma.TileValue" android:maxLines="1" android:textSize="16sp" tools:text="Moderate" />
                        <View android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="10dp" android:background="@drawable/bento_uv_track" />
                    </LinearLayout>
                    <LinearLayout style="@style/Soma.Tile" android:layout_marginStart="6dp">
                        <TextView style="@style/Soma.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pressure &amp; air quality" />
                        <ImageView android:id="@+id/pressure" style="@style/Soma.TileIcon" android:background="@drawable/soma_chip_saffron" android:src="@drawable/ic_feather_activity" android:tint="@color/soma_saffron" />
                        <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                        <TextView android:id="@+id/todayPressure" style="@style/Soma.TileValue" tools:text="1012 hPa" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Daylight — Soma-style sun arc -->
                <LinearLayout
                    android:id="@+id/stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bento_tile"
                    android:padding="18dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView style="@style/Soma.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Daylight" android:layout_alignParentStart="true" />
                        <TextView android:id="@+id/lastUpdate" style="@style/Soma.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:textColor="@color/soma_text_muted" tools:text="9:33 PM" />
                    </RelativeLayout>

                    <com.tac.Weathercast.utils.SunArcView
                        android:id="@+id/sunArc"
                        android:layout_width="match_parent"
                        android:layout_height="76dp"
                        android:layout_marginTop="12dp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">
                        <TextView android:id="@+id/todaySunrise" style="@style/Soma.TileValue" android:layout_marginTop="0dp" android:textSize="16sp" android:layout_alignParentStart="true" tools:text="06:04" />
                        <TextView android:id="@+id/todaySunset" style="@style/Soma.TileValue" android:layout_marginTop="0dp" android:textSize="16sp" android:layout_alignParentEnd="true" tools:text="18:22" />
                        <TextView android:id="@+id/daylightLength" style="@style/Soma.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerHorizontal="true" android:textSize="12sp" tools:text="13h 16m" />
                    </RelativeLayout>
                </LinearLayout>

                <TextView style="@style/Soma.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hourly" android:layout_marginTop="26dp" android:layout_marginBottom="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/hourlyStrip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/hourly_capsule" />

                <TextView style="@style/Soma.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7-day" android:layout_marginTop="26dp" android:layout_marginBottom="12dp" />

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/tab_layout_background"
                    app:tabMode="scrollable"
                    app:tabBackground="@drawable/tab_layout_selector"
                    app:tabSelectedTextColor="@color/soma_ember"
                    app:tabTextColor="@color/soma_text_muted"
                    app:tabPaddingStart="16dp"
                    app:tabPaddingEnd="16dp"
                    app:tabIndicatorHeight="0dp"
                    app:tabRippleColor="@null"
                    app:tabTextAppearance="@style/TabTextAppearance" />
            </LinearLayout>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</LinearLayout>
