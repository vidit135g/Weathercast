<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:chart="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/graph_scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soma_bg"
    android:fitsSystemWindows="true"
    tools:context="com.tac.Weathercast.activities.GraphActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/graph_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:background="@color/soma_bg"
            android:paddingTop="6dp"
            app:contentInsetStartWithNavigation="0dp"
            app:navigationContentDescription="@string/abc_action_bar_up_description"
            app:navigationIcon="@drawable/ic_soma_back">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fraunces"
                android:letterSpacing="-0.02"
                android:text="Trends"
                android:textColor="@color/soma_ink"
                android:textSize="24sp" />
        </androidx.appcompat.widget.Toolbar>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:background="@drawable/bento_tile"
            android:padding="18dp">
            <TextView android:id="@+id/graphTemperatureTextView" style="@style/Soma.Label"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/temperature" />
            <com.db.chart.view.LineChartView android:id="@+id/graph_temperature"
                android:layout_width="match_parent" android:layout_height="190dp"
                android:layout_marginTop="10dp" chart:chart_axisBorderSpacing="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/bento_tile"
            android:padding="18dp">
            <TextView android:id="@+id/graphRainTextView" style="@style/Soma.Label"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rain" />
            <com.db.chart.view.LineChartView android:id="@+id/graph_rain"
                android:layout_width="match_parent" android:layout_height="190dp"
                android:layout_marginTop="10dp" chart:chart_axisBorderSpacing="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/bento_tile"
            android:padding="18dp">
            <TextView android:id="@+id/graphPressureTextView" style="@style/Soma.Label"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pressure" />
            <com.db.chart.view.LineChartView android:id="@+id/graph_pressure"
                android:layout_width="match_parent" android:layout_height="190dp"
                android:layout_marginTop="10dp" chart:chart_axisBorderSpacing="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/bento_tile"
            android:padding="18dp">
            <TextView android:id="@+id/graphWindSpeedTextView" style="@style/Soma.Label"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/wind_speed" />
            <com.db.chart.view.LineChartView android:id="@+id/graph_windspeed"
                android:layout_width="match_parent" android:layout_height="190dp"
                android:layout_marginTop="10dp" chart:chart_axisBorderSpacing="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
