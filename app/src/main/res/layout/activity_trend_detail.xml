<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF15224A">

    <com.tac.Weathercast.utils.ElementalFieldView
        android:id="@+id/fieldBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="40dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/back" android:layout_width="42dp" android:layout_height="42dp" android:padding="9dp" android:src="@drawable/ic_close_black_24dp" android:tint="@color/soma_ink" android:background="?attr/selectableItemBackgroundBorderless" android:layout_marginStart="-9dp" />
                <TextView android:id="@+id/title" style="@style/Soma.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="24sp" android:layout_marginStart="6dp" tools:text="Temperature" />
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" android:layout_marginTop="14dp">
                <TextView android:id="@+id/bigValue" style="@style/Soma.Display" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="44sp" tools:text="23°" />
                <TextView android:id="@+id/trendChip" style="@style/Soma.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginBottom="8dp" android:textSize="13sp" tools:text="↑ rising" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginTop="18dp">
                <LinearLayout android:id="@+id/stat1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bento_tile" android:padding="14dp" android:elevation="3dp" android:layout_marginEnd="5dp">
                    <TextView style="@style/Soma.Label" android:id="@+id/stat1Label" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="High" />
                    <TextView style="@style/Soma.Display" android:id="@+id/stat1Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:layout_marginTop="4dp" tools:text="28°" />
                </LinearLayout>
                <LinearLayout android:id="@+id/stat2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bento_tile" android:padding="14dp" android:elevation="3dp" android:layout_marginHorizontal="5dp">
                    <TextView style="@style/Soma.Label" android:id="@+id/stat2Label" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="Low" />
                    <TextView style="@style/Soma.Display" android:id="@+id/stat2Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:layout_marginTop="4dp" tools:text="19°" />
                </LinearLayout>
                <LinearLayout android:id="@+id/stat3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bento_tile" android:padding="14dp" android:elevation="3dp" android:layout_marginStart="5dp">
                    <TextView style="@style/Soma.Label" android:id="@+id/stat3Label" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="Average" />
                    <TextView style="@style/Soma.Display" android:id="@+id/stat3Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:layout_marginTop="4dp" tools:text="23°" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bento_tile" android:padding="16dp" android:elevation="3dp" android:layout_marginTop="14dp">
                <com.tac.Weathercast.utils.TrendChartView android:id="@+id/chart" android:layout_width="match_parent" android:layout_height="210dp" />
            </LinearLayout>

            <TextView android:id="@+id/reading" style="@style/Soma.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="14sp" tools:text="Warming up through the week — from 21° now to a peak of 34° around Thursday." />

            <TextView style="@style/Soma.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="By the hour" android:layout_marginTop="26dp" android:layout_marginBottom="8dp" />
            <LinearLayout android:id="@+id/hourList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
