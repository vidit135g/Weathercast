<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bento_tile"
    android:padding="18dp">

    <View
        android:id="@+id/lineView"
        android:layout_width="0dp"
        android:layout_height="0dp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/itemIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:contentDescription="@null"
            android:src="@drawable/soma_wx_cloudy" />

        <TextView
            android:id="@+id/itemDate"
            style="@style/Soma.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            tools:text="16:00" />

        <TextView
            android:id="@+id/itemTemperature"
            style="@style/Soma.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/itemDate"
            android:layout_marginTop="2dp"
            android:textSize="22sp"
            tools:text="24 °C" />

        <TextView
            android:id="@+id/itemDescription"
            style="@style/Soma.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/itemTemperature"
            android:layout_marginTop="6dp"
            tools:text="Clear sky" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="@color/soma_border" />

    <TextView
        android:id="@+id/itemWind"
        style="@style/Soma.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        tools:text="Wind: 3.0 m/s" />

    <TextView
        android:id="@+id/itemPressure"
        style="@style/Soma.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        tools:text="Pressure: 1012 hPa" />

    <TextView
        android:id="@+id/itemHumidity"
        style="@style/Soma.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        tools:text="Humidity: 60 %" />
</LinearLayout>
