<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/soma_surface_muted" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/soma_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/soma_surface" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/soma_border" />
        </shape>
    </item>
</selector>
